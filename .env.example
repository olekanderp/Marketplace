# ── Database ───────────────────────────────────────────────────────────────
# Used by both the Next.js app (Sequelize) and sequelize-cli (migrations/seeds).
# (Host port 5433 avoids clashing with a Postgres you may already run on 5432.)
DATABASE_URL=postgres://n5deal:n5deal@localhost:5433/n5deal
# Separate database used by the automated tests (optional locally).
DATABASE_URL_TEST=postgres://n5deal:n5deal@localhost:5433/n5deal_test

# ── Auth ───────────────────────────────────────────────────────────────────
# Secret for signing JWT access tokens. MUST be set — the app refuses to start
# without it. Generate one with:  openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000000000
# Access token lifetime.
JWT_EXPIRES_IN=7d

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Marks cookies as Secure (set to "true" only when served over HTTPS).
COOKIE_SECURE=false
